# ------------------------------------------------------------------------------
# Pulsar — .gitignore
# ------------------------------------------------------------------------------

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Miscellaneous & Editor Junk
*.class
*.log
*.pyc
*.swp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE & Editor Configuration
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter, Dart & Pub Build Artifacts
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/
/coverage/
.widget_preview/

# Ephemeral Platform Bridges (Generated by Flutter)
**/ephemeral/
**/GeneratedPluginRegistrant.*

# Android & Gradle Build Artifacts
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
.cxx/
**/.cxx/
/android/app/debug
/android/app/profile
/android/app/release
captures/
**/captures/

# Local Machine SDK Paths & Configuration (Never share machine-specific paths)
local.properties
**/local.properties

# Android Keystores & Signing Keys (Security & Privacy)
key.properties
**/key.properties
*.keystore
*.jks

# Environment & Secret Files
.env
.env.*
!*.env.example
*.pem
*.key
*.p12
*.pfx

# SQLite Databases & Local Task Storage (User Privacy)
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Release Packages & Binaries (APKs >100MB exceed GitHub push limits; use GitHub Releases)
*.apk
*.aab
*.ipa
*.xcarchive

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# Explicit Whitelists (Crucial files for running Pulsar offline after cloning)
# ------------------------------------------------------------------------------
# Cactus On-Device AI Models (Whistle ~16.9 MB, Needle 3 ~35.3 MB)
!assets/models/*.cact
!assets/models/README.md

# Audio assets & App Icons
!assets/audio/*.wav
!assets/icons/*.png

# App screenshots for README
!App_photos/*

# Native C++ Needle Engine Static Library (Required to build Android ARM64)
!android/app/src/main/cpp/needle/**/libneedle.a
